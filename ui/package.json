{
  "name": "rules-manager-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Electron tray UI for Dev-Centr rules-manager",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "org.devcentr.rules-manager",
    "productName": "Rules Manager",
    "directories": { "output": "dist" },
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.developer-tools" },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "desktop": {
        "Name": "Rules Manager",
        "Comment": "Compose and watch agent-rules"
      }
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
